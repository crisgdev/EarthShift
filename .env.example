EARTHSHIFT_CACHE_TTL_SECONDS=300
EARTHSHIFT_ENV=development
EARTHSHIFT_NASA_TIMEOUT_SECONDS=15

EARTHSHIFT_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# EarthShift Advisor -> Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional legacy Gemini connector; Advisor and Phenomena use Groq.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EARTHSHIFT_DEMO_MODE=false
EARTHSHIFT_PHENOMENA_AI_ENABLED=true

# Node forwards browser /api requests to FastAPI. Set the public API URL in Vercel (or Render for the full-stack alternative).
EARTHSHIFT_BACKEND_URL=http://127.0.0.1:8000
# Optional direct browser API URL; normally leave empty to use the same-origin proxy.
VITE_EARTHSHIFT_API_URL=
