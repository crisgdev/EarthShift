# Development only. Copy to frontend/.env.
EARTHSHIFT_BACKEND_URL=http://127.0.0.1:8000

# Leave empty for the same-origin Express/Vercel proxy, also in previews.
# Direct mode requires public HTTPS in production and explicit FastAPI CORS.
# Never put secrets in VITE_* variables.
VITE_EARTHSHIFT_API_URL=
VITE_CARTO_API_KEY=

# Optional server-only NASA keys.
NASA_API_KEY=DEMO_KEY
FIRMS_MAP_KEY=
