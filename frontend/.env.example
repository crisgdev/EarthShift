# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional NASA API keys for extended endpoints (e.g. NASA FIRMS / APOD / DONKI).
# EONET v3, POWER v2, and GIBS WMTS work out-of-the-box without requiring a key.
NASA_API_KEY="DEMO_KEY"
FIRMS_MAP_KEY=""

# CARTO Basemaps browser key. Request at https://carto.com/basemaps/apikey/
VITE_CARTO_API_KEY=

# EarthShift API origin; empty uses the Express proxy.
VITE_EARTHSHIFT_API_URL=
# Server-only FastAPI origin.
EARTHSHIFT_BACKEND_URL=http://127.0.0.1:8000
