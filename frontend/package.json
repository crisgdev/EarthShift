{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs server.ts",
    "start": "node node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node scripts/check-deployment.mjs && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/tsx/dist/cli.mjs server.ts --preview",
    "clean": "rm -rf dist server.js",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:deployment": "node node_modules/tsx/dist/cli.mjs --test tests/deployment.integration.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
